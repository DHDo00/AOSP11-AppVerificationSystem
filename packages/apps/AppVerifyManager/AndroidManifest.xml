<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.appverify">

    <uses-permission android:name="android.permission.MANAGE_APP_VERIFICATION" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_lock_idle_lock"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".BlockActivity"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar.Fullscreen"
            android:exported="true"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"/>

        <activity android:name=".ReviewActivity" android:label="@string/btn_review_events"/> <activity android:name=".WhitelistActivity" android:label="@string/btn_manage_whitelist"/> <activity android:name=".AppSelectionActivity" android:label="@string/btn_scan_add"/> <receiver android:name=".EventReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.android.appverify.ACTION_EVENT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
